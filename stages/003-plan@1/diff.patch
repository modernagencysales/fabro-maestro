@@ -0,0 +1,58 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "title": "FactorySpecEval",
+  "description": "Output contract for the spec evaluator stage. Scores spec quality and decides whether to approve, revise, or reject.",
+  "type": "object",
+  "additionalProperties": false,
+  "required": ["decision", "overall_score", "scores", "blocking_issues"],
+  "properties": {
+    "decision": {
+      "type": "string",
+      "enum": ["pass", "revise", "fail"],
+      "description": "pass = overall_score >= 4.0 and no blocking issues; revise = needs changes; fail = fundamental problems"
+    },
+    "overall_score": {
+      "type": "number",
+      "minimum": 0,
+      "maximum": 5,
+      "description": "Weighted average of dimension scores. Must be >= 4.0 to pass."
+    },
+    "scores": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "clarity",
+        "acceptance_criteria_quality",
+        "non_goals_defined",
+        "architecture_fit",
+        "risk_identification",
+        "testability",
+        "rollback_clarity",
+        "scope_control"
+      ],
+      "properties": {
+        "clarity": { "type": "integer", "minimum": 1, "maximum": 5 },
+        "acceptance_criteria_quality": { "type": "integer", "minimum": 1, "maximum": 5 },
+        "non_goals_defined": { "type": "integer", "minimum": 1, "maximum": 5 },
+        "architecture_fit": { "type": "integer", "minimum": 1, "maximum": 5 },
+        "risk_identification": { "type": "integer", "minimum": 1, "maximum": 5 },
+        "testability": { "type": "integer", "minimum": 1, "maximum": 5 },
+        "rollback_clarity": { "type": "integer", "minimum": 1, "maximum": 5 },
+        "scope_control": { "type": "integer", "minimum": 1, "maximum": 5 }
+      }
+    },
+    "blocking_issues": {
+      "type": "array",
+      "items": { "type": "string", "minLength": 1 },
+      "description": "List of issues that prevent approval. Must be empty for decision=pass."
+    },
+    "recommended_revision_node": {
+      "type": ["string", "null"],
+      "description": "Which workflow node to loop back to if decision=revise. Null if decision=pass."
+    },
+    "notes": {
+      "type": "string",
+      "description": "Optional free-text evaluator commentary."
+    }
+  }
+}
