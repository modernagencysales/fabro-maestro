// 06a — The CHILD workflow. A normal, standalone workflow (it's just example 02's
// loop) that can also be invoked by a parent via a house node. See 06-subworkflow-parent.
// CONCEPT: encapsulation + reuse. The child runs its OWN engine with isolated logs
//   and checkpoints, keeping the parent's trace clean.
digraph ImplementAndTest {
    graph [goal="Implement the plan in plan.md and make the tests pass"]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare,  label="Exit"]

    implement [label="Implement", prompt="Read plan.md and implement every step. Write the code and pytest tests to disk."]
    validate  [label="Run Tests", shape=parallelogram, script="python3 -m pytest -v 2>&1 || true"]
    gate      [label="Tests passing?", shape=diamond]

    start -> implement -> validate -> gate
    gate -> exit      [label="Pass", condition="outcome=succeeded"]
    gate -> implement [label="Fix",  max_visits=5]
}
