{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FactoryReviewFinding",
  "type": "object",
  "additionalProperties": false,
  "required": ["severity", "file", "issue", "recommendation", "blocks_release"],
  "properties": {
    "severity": {
      "type": "string",
      "enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW"]
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "issue": {
      "type": "string",
      "minLength": 1
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    },
    "blocks_release": {
      "type": "boolean"
    }
  }
}
