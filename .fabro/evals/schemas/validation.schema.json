{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FactoryValidationResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "mode", "note"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    }
  }
}
